{
  "name": "agbtech-planner",
  "private": true,
  "version": "1.0.1",
  "description": "Premium project planner and task management application.",
  "author": "AGB Technologies - https://agbtechnologies.com - Shubham Pardhi",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "trust-app": "powershell -Command \"Start-Process powershell -ArgumentList '-NoProfile -ExecutionPolicy Bypass -Command Add-MpPreference -ExclusionPath \\\"$([System.Environment]::GetFolderPath('ProgramFiles'))\\AGBTech Planner\\\"' -Verb RunAs\"",
    "trust-cert": "powershell -Command \"Start-Process powershell -ArgumentList '-NoProfile -ExecutionPolicy Bypass -Command \\\"$pass = ConvertTo-SecureString -String agbtech123 -AsPlainText -Force; Import-PfxCertificate -FilePath scripts/agbtech.pfx -CertStoreLocation Cert:/LocalMachine/Root -Password $pass; Import-PfxCertificate -FilePath scripts/agbtech.pfx -CertStoreLocation Cert:/LocalMachine/TrustedPublisher -Password $pass\\\"' -Verb RunAs\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.6.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-resizable-panels": "^4.7.6",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.agbtech.planner",
    "productName": "AGBTech Planner",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*"
    ],
    "win": {
      "cscLink": "scripts/agbtech.pfx",
      "cscKeyPassword": "agbtech123",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AGBTech Planner"
    },
    "appx": {
      "identityName": "AGBTech.Planner",
      "publisher": "CN=AGB Technologies",
      "publisherDisplayName": "AGB Technologies"
    }
  }
}